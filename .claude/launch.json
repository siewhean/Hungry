{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo Metro (start)",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npm run start"],
      "port": 8081
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx expo start --web --port 8082"],
      "port": 8082
    }
  ]
}
