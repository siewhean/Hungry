# Hungry public app environment
EXPO_PUBLIC_APP_ENV=development
# Derived rollout:
# - FEATURE_FLAGS.merchantClaimCtaEnabled = true only when EXPO_PUBLIC_APP_ENV=staging
# - false for development/production

# Supabase client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_REDIRECT_URL=hungry://auth/callback

# Server-only secret (never expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_ENRICHMENT_API_KEY=

# Supabase Edge Function server/runtime configuration
GUEST_SESSION_API_KEY=
GUEST_SESSION_ALLOWED_ORIGINS=
INGEST_MENU_PHOTO_ALLOWED_ORIGINS=
OPS_DISHES_DRAFT_ALLOWED_ORIGINS=
ACCOUNT_DELETION_WORKER_TOKEN=

# Website / marketing server-side configuration
HUNGRY_CONSOLE_API_TOKEN=
HUNGRY_CONSOLE_ADMIN_TOKEN=
HUNGRY_MERCHANT_PORTAL_ORIGIN=
HUNGRY_RATE_LIMIT_REDIS_REST_URL=
HUNGRY_RATE_LIMIT_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_HUNGRY_CONSOLE_PROTOTYPE_STORAGE=

# Mapbox tokens
# Your Mapbox public token here
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Your Mapbox secret token here
MAPBOX_SECRET_TOKEN=

# PostHog analytics
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry monitoring
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Expo/EAS
EXPO_TOKEN=

# Data source mode: mock | supabase
HUNGRY_DATA_SOURCE=mock
EXPO_PUBLIC_OAUTH_PROVIDERS_ENABLED=true

# Optional linked Supabase smoke checks; service role requires explicit opt-in.
HUNGRY_SUPABASE_SMOKE_URL=
HUNGRY_SUPABASE_SMOKE_ANON_KEY=
HUNGRY_SUPABASE_SMOKE_PROJECT_REF=
HUNGRY_SUPABASE_SMOKE_SERVICE_ROLE_KEY=
HUNGRY_ALLOW_SERVICE_ROLE_SMOKE=0
HUNGRY_SUPABASE_SMOKE_REQUIRED=0

# Primary Google Maps key (Places API New enabled)
GOOGLE_MAPS_ENRICHMENT_API_KEY=

# Backup Google Maps key (separate key/project)
GOOGLE_MAPS_ENRICHMENT_API_KEY_BACKUP=

# Primary OAuth refresh-token set (for Google Sheets import)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Backup OAuth refresh-token set (for Google Sheets import fallback/secondary account)
GOOGLE_OAUTH_CLIENT_ID_BACKUP=
GOOGLE_OAUTH_CLIENT_SECRET_BACKUP=
GOOGLE_OAUTH_REFRESH_TOKEN_BACKUP=

# Optional short-lived fallback tokens (not preferred)
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN_BACKUP=
