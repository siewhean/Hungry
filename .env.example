# Hungry public app environment
EXPO_PUBLIC_APP_ENV=development
# Derived rollout:
# - FEATURE_FLAGS.merchantClaimCtaEnabled = true only when EXPO_PUBLIC_APP_ENV=staging
# - false for development/production

# Supabase client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_REDIRECT_URL=hungry://auth/callback

# Server-only secret (never expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_API_KEY=
OPS_DISHES_DRAFT_API_KEY=
GOOGLE_MAPS_ENRICHMENT_API_KEY=

# Mapbox tokens
# Your Mapbox public token here
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Your Mapbox secret token here
MAPBOX_SECRET_TOKEN=

# PostHog analytics
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry monitoring
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Expo/EAS
EXPO_TOKEN=

# Data source mode: mock | supabase
HUNGRY_DATA_SOURCE=mock

# Primary Google Maps key (Places API New enabled)
GOOGLE_MAPS_ENRICHMENT_API_KEY=

# Backup Google Maps key (separate key/project)
GOOGLE_MAPS_ENRICHMENT_API_KEY_BACKUP=

# Primary OAuth refresh-token set (for Google Sheets import)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Backup OAuth refresh-token set (for Google Sheets import fallback/secondary account)
GOOGLE_OAUTH_CLIENT_ID_BACKUP=
GOOGLE_OAUTH_CLIENT_SECRET_BACKUP=
GOOGLE_OAUTH_REFRESH_TOKEN_BACKUP=

# Optional short-lived fallback tokens (not preferred)
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN_BACKUP=
