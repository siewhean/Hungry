# Tracked public/build config only. Server-only secrets (service role key, Sentry auth
# token, Mapbox secret token, Expo token, worker tokens) must never be added here: set
# them in untracked .env.local, EAS/CI secrets, or the Supabase secret store. See .env.example.
EXPO_PUBLIC_APP_ENV=production
# merchantClaimCtaEnabled is derived from EXPO_PUBLIC_APP_ENV (false in production)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
EXPO_PUBLIC_HUNGRY_DATA_SOURCE=supabase
