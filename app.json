{
  "expo": {
    "name": "Hungry",
    "slug": "hungry-mobile",
    "version": "0.1.0",
    "runtimeVersion": "0.1.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6d724772-04c3-4823-91bc-a1f7604c9f15"
    },
    "orientation": "portrait",
    "scheme": "hungry",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hungry.mobile",
      "appleTeamId": "94R58J6LA2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hungry uses your location to rank nearby dishes and map results."
      }
    },
    "android": {
      "package": "app.hungry.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "@sentry/react-native",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "hungry-3z"
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "6d724772-04c3-4823-91bc-a1f7604c9f15"
      }
    }
  }
}
