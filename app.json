{
  "expo": {
    "name": "Hungry",
    "slug": "hungry-mobile",
    "version": "0.1.0",
    "runtimeVersion": "0.1.0",
    "icon": "./assets/images/Logo/hungry_logo_icon_transparent.png",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/6d724772-04c3-4823-91bc-a1f7604c9f15"
    },
    "orientation": "portrait",
    "scheme": "hungry",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hungry.mobile",
      "appleTeamId": "94R58J6LA2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hungry uses your location to rank nearby dishes and map results.",
        "NSCameraUsageDescription": "Hungry uses your camera to take photos of your meals for reviews.",
        "NSMicrophoneUsageDescription": "Hungry uses your microphone to record audio for videos.",
        "NSPhotoLibraryUsageDescription": "Hungry accesses your photo library so you can attach photos to reviews and profile.",
        "NSPhotoLibraryAddUsageDescription": "Hungry saves shared dish images to your photo library when you choose to download them.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "grab",
          "foodpanda",
          "deliveroo"
        ]
      }
    },
    "android": {
      "package": "app.hungry.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "expo-secure-store",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.18.2"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "hungry-3z"
        }
      ],
      "expo-audio",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hungry accesses your photo library so you can attach photos to reviews and profile.",
          "cameraPermission": "Hungry uses your camera to take photos of your meals for reviews."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6d724772-04c3-4823-91bc-a1f7604c9f15"
      }
    }
  }
}
