{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "HUNGRY_DATA_SOURCE": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "HUNGRY_DATA_SOURCE": "supabase"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "HUNGRY_DATA_SOURCE": "supabase"
      },
      "postBuildCommand": "npx @sentry/wizard@latest -i reactNative --skip-connect-react-native-version-check"
    }
  },
  "submit": {
    "production": {}
  }
}
