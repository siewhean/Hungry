{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "HUNGRY_DATA_SOURCE": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "HUNGRY_DATA_SOURCE": "supabase"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "HUNGRY_DATA_SOURCE": "supabase"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
