{
  "cli": {
    "version": ">= 21.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_HUNGRY_DATA_SOURCE": "supabase"
      }
    },
    "internal-alpha": {
      "distribution": "internal",
      "channel": "internal-alpha",
      "environment": "preview",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_HUNGRY_DATA_SOURCE": "supabase",
        "EXPO_PUBLIC_CATALOG_READ_V2": "1",
        "EXPO_PUBLIC_ENABLE_SOCIAL_FEED": "0",
        "EXPO_PUBLIC_ENABLE_POSTS": "0",
        "EXPO_PUBLIC_ENABLE_REVIEWS": "0",
        "EXPO_PUBLIC_ENABLE_ACTIVITY": "0",
        "EXPO_PUBLIC_ENABLE_READS": "0",
        "EXPO_PUBLIC_ENABLE_MAP": "0",
        "EXPO_PUBLIC_ENABLE_WHEEL": "0",
        "EXPO_PUBLIC_ENABLE_CRAVE": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_HUNGRY_DATA_SOURCE": "supabase",
        "EXPO_PUBLIC_CATALOG_READ_V2": "1",
        "EXPO_PUBLIC_ENABLE_SOCIAL_FEED": "0",
        "EXPO_PUBLIC_ENABLE_POSTS": "0",
        "EXPO_PUBLIC_ENABLE_REVIEWS": "0",
        "EXPO_PUBLIC_ENABLE_ACTIVITY": "0",
        "EXPO_PUBLIC_ENABLE_READS": "0",
        "EXPO_PUBLIC_ENABLE_MAP": "0",
        "EXPO_PUBLIC_ENABLE_WHEEL": "0",
        "EXPO_PUBLIC_ENABLE_CRAVE": "0"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_HUNGRY_DATA_SOURCE": "supabase",
        "EXPO_PUBLIC_CATALOG_READ_V2": "1",
        "EXPO_PUBLIC_ENABLE_SOCIAL_FEED": "0",
        "EXPO_PUBLIC_ENABLE_POSTS": "0",
        "EXPO_PUBLIC_ENABLE_REVIEWS": "0",
        "EXPO_PUBLIC_ENABLE_ACTIVITY": "0",
        "EXPO_PUBLIC_ENABLE_READS": "0",
        "EXPO_PUBLIC_ENABLE_MAP": "0",
        "EXPO_PUBLIC_ENABLE_WHEEL": "0",
        "EXPO_PUBLIC_ENABLE_CRAVE": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
