unless [].respond_to?(:filter_map)
  class Array
    def filter_map
      return enum_for(:filter_map) unless block_given?

      each_with_object([]) do |item, result|
        value = yield item
        result << value if value
      end
    end
  end
end

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
require 'shellwords'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

def build_setting_words(value)
  return [] if value.nil?

  if value.respond_to?(:to_a) && !value.is_a?(String)
    return value.to_a.flat_map { |item| build_setting_words(item) }
  end

  Shellwords.split(value.to_s)
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
# Force React Native dependencies/core to build from source.
# This avoids intermittent prebuilt pod validation failures like:
# "React-Core-prebuilt ... Missing required attribute `source`".
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
platform :ios, podfile_properties['ios.deploymentTarget'] || '16.0'
inhibit_all_warnings!

prepare_react_native_project!

target 'Hungry' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    deployment_target = podfile_properties['ios.deploymentTarget'] || '16.0'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
        build_config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        build_config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        build_config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        build_config.build_settings['CLANG_WARN_NULLABILITY_COMPLETENESS'] = 'NO'
        build_config.build_settings['CLANG_WARN_NULLABLE_TO_NONNULL_CONVERSION'] = 'NO'
        build_config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        build_config.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'

        if target.name == 'fmt' || target.name == 'RCT-Folly'
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          defs = build_setting_words(defs)
          defs << 'FMT_USE_CONSTEXPR=0' unless defs.include?('FMT_USE_CONSTEXPR=0')
          defs << 'FMT_USE_CONSTEVAL=0' unless defs.include?('FMT_USE_CONSTEVAL=0')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

          cxx_flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(inherited)']
          cxx_flags = build_setting_words(cxx_flags)
          cxx_flags << '-Wno-invalid-constexpr' unless cxx_flags.include?('-Wno-invalid-constexpr')
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxx_flags
        end

        if target.name == 'RCT-Folly'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        end
      end
    end

    fmt_header_paths = [
      File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h'),
      File.join(installer.sandbox.root, 'Headers', 'Public', 'fmt', 'fmt', 'base.h')
    ]

    fmt_header_paths.each do |fmt_header|
      next unless File.exist?(fmt_header)

      begin
        File.chmod(0o644, fmt_header)
      rescue StandardError
      end

      contents = File.read(fmt_header)
      patched = contents
        .gsub('#  define FMT_USE_CONSTEVAL 1', '#  define FMT_USE_CONSTEVAL 0')
        .gsub('constexpr auto is_constant_evaluated', 'inline auto is_constant_evaluated')

      File.write(fmt_header, patched) unless patched == contents
    end

    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        if target.name == 'EXConstants' && phase.name == '[CP-User] Generate app.config for prebuilt Constants.manifest'
          # The default script can break when project paths contain spaces.
          phase.shell_script = 'bash -l -c "\"$PODS_TARGET_SRCROOT/../scripts/get-app-config-ios.sh\""'
        end

        if target.name == 'EXUpdates' && phase.name == '[CP-User] Generate updates resources for expo-updates'
          # Same quoting issue for expo-updates in paths containing spaces.
          phase.shell_script = 'bash -l -c "\"$PODS_TARGET_SRCROOT/../scripts/create-updates-resources-ios.sh\""'
        end

        # Avoid dependency-analysis warning for script phases that are expected to run every build.
        if phase.name == '[CP-User] [Hermes] Replace Hermes for the right configuration, if needed' ||
           phase.name == '[CP-User] Generate updates resources for expo-updates'
          phase.always_out_of_date = '1'
        end
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        next unless native_target.name == 'Hungry'

        native_target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
          build_config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
          build_config.build_settings['CLANG_WARN_NULLABILITY_COMPLETENESS'] = 'NO'
          build_config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
          build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          build_config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        end

        native_target.shell_script_build_phases.each do |phase|
          next unless phase.name == 'Bundle React Native code and images'

          # Ensure paths are always quoted so projects under directories with spaces work.
          phase.shell_script = <<~'SCRIPT'
            set -e

            if [ -f "$PODS_ROOT/../.xcode.env" ]; then
              . "$PODS_ROOT/../.xcode.env"
            fi
            if [ -f "$PODS_ROOT/../.xcode.env.local" ]; then
              . "$PODS_ROOT/../.xcode.env.local"
            fi

            if [ -z "${PROJECT_DIR:-}" ] && [ -n "${PODS_ROOT:-}" ]; then
              PROJECT_DIR="$(dirname "$PODS_ROOT")"
            fi

            if [ -z "${NODE_BINARY:-}" ] || [ ! -x "$(command -v "$NODE_BINARY" 2>/dev/null || echo '')" ]; then
              if [ -x "/usr/local/bin/node" ]; then
                NODE_BINARY="/usr/local/bin/node"
              elif [ -x "/opt/homebrew/bin/node" ]; then
                NODE_BINARY="/opt/homebrew/bin/node"
              else
                NODE_BINARY="$(command -v node || true)"
              fi
            fi

            if [ -z "$NODE_BINARY" ]; then
              NODE_BINARY="/usr/bin/env node"
            fi

            : "${ENTRY_FILE:=index.ts}"

            REACT_NATIVE_XCODE_SH="$("$NODE_BINARY" --print "require('path').dirname(require.resolve('react-native/package.json')) + '/scripts/react-native-xcode.sh'")"
            if [ -z "$REACT_NATIVE_XCODE_SH" ] || [ ! -f "$REACT_NATIVE_XCODE_SH" ]; then
              echo "❌ Unable to locate react-native xcode script."
              echo "NODE_BINARY=$NODE_BINARY"
              exit 1
            fi
            SENTRY_XCODE_SH="$("$NODE_BINARY" --print "require('path').dirname(require.resolve('@sentry/react-native/package.json')) + '/scripts/sentry-xcode.sh'")"

            if [ "$CONFIGURATION" = "Debug" ] || [ "$PLATFORM_NAME" = "iphonesimulator" ]; then
              /bin/sh "$REACT_NATIVE_XCODE_SH"
              exit 0
            fi

            if [ -n "$SENTRY_XCODE_SH" ] && [ -f "$SENTRY_XCODE_SH" ]; then
              /bin/sh "$SENTRY_XCODE_SH" "$REACT_NATIVE_XCODE_SH"
            else
              /bin/sh "$REACT_NATIVE_XCODE_SH"
            fi
          SCRIPT
        end

        aggregate_target.user_project.save
      end
    end

    installer.pods_project.save
  end
end
