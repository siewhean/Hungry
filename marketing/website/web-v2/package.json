{
  "name": "web-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev:clean": "rm -rf .next && rm -f .next/lock && NEXT_DISABLE_SWC=1 /opt/homebrew/bin/node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "dev": "rm -f .next/lock && NEXT_DISABLE_SWC=1 /opt/homebrew/bin/node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "rm -f .next/lock && NEXT_DISABLE_SWC=1 /opt/homebrew/bin/node ./node_modules/next/dist/bin/next build",
    "build:webpack": "rm -f .next/lock && NEXT_DISABLE_SWC=1 /opt/homebrew/bin/node ./node_modules/next/dist/bin/next build --webpack",
    "start": "rm -f .next/lock && NEXT_DISABLE_SWC=1 /opt/homebrew/bin/node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "seo:audit": "node scripts/seo-ai-readiness-check.mjs",
    "security:audit": "node scripts/security-route-contracts.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  }
}
