{
  "name": "web-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev:clean": "rm -rf .next && rm -f .next/lock && WATCHPACK_POLLING=true NEXT_DISABLE_SWC=1 node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "dev": "rm -f .next/lock && WATCHPACK_POLLING=true NEXT_DISABLE_SWC=1 node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "rm -f .next/lock && NEXT_DISABLE_SWC=1 node ./node_modules/next/dist/bin/next build --webpack",
    "build:webpack": "rm -f .next/lock && NEXT_DISABLE_SWC=1 node ./node_modules/next/dist/bin/next build --webpack",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "waitlist:e2e": "node scripts/waitlist-e2e.mjs",
    "start": "rm -f .next/lock && NEXT_DISABLE_SWC=1 node ./node_modules/next/dist/bin/next start",
    "a11y:contracts": "node scripts/accessibility-contracts.mjs",
    "a11y:keyboard": "node scripts/keyboard-smoke.mjs",
    "env:validate": "node scripts/deployment-env-contracts.mjs",
    "lint": "eslint",
    "legal:validate": "node scripts/legal-readiness-contracts.mjs",
    "perf:lighthouse": "node scripts/lighthouse-qc.mjs",
    "predeploy:local": "node scripts/predeploy-local-gates.mjs",
    "private-routes:qc": "node scripts/private-route-qc.mjs",
    "routes:inventory": "node scripts/route-inventory-contracts.mjs",
    "seo:audit": "node scripts/seo-ai-readiness-check.mjs",
    "seo:links": "node scripts/check-rendered-links.mjs",
    "seo:validate": "node scripts/seo-ai-readiness-check.mjs",
    "seo:sitemap": "node scripts/validate-sitemap.mjs",
    "seo:structured-data": "node scripts/validate-structured-data.mjs",
    "security:audit": "node scripts/security-route-contracts.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "@vercel/analytics": "^1.5.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  }
}
