{
  "name": "hungry-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ./scripts/run-expo.cjs start",
    "android": "node ./scripts/run-expo.cjs run:android",
    "ios": "node ./scripts/run-expo.cjs run:ios --no-build-cache",
    "web": "node ./scripts/run-expo.cjs start --web",
    "eas:channel:preview": "npx eas-cli channel:create preview --non-interactive || true",
    "eas:channel:production": "npx eas-cli channel:create production --non-interactive || true",
    "update:preview": "npx eas-cli update --channel preview --message \"${npm_config_msg:-preview update}\"",
    "update:production": "npx eas-cli update --channel production --message \"${npm_config_msg:-production update}\"",
    "typecheck": "tsc --noEmit",
    "test": "HUNGRY_DISABLE_ASYNC_STORAGE=1 HUNGRY_DISABLE_SECURE_STORE=1 TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "smoke:supabase-chat": "node scripts/supabase-chat-smoke.mjs",
    "smoke:native": "node scripts/run-maestro-smoke.mjs ios",
    "smoke:native:ios": "node scripts/run-maestro-smoke.mjs ios",
    "smoke:native:ios:prepared": "node scripts/prepare-maestro-smoke.mjs ios",
    "smoke:native:ios:chat": "node scripts/run-maestro-smoke.mjs ios-chat",
    "smoke:native:ios:chat:prepared": "node scripts/prepare-maestro-smoke.mjs ios-chat",
    "smoke:native:ios:media": "node scripts/run-maestro-smoke.mjs ios-media",
    "smoke:native:ios:media:prepared": "node scripts/prepare-maestro-smoke.mjs ios-media",
    "seed:generate": "tsx scripts/seed/generateSeedSQL.ts",
    "data:enrich": "python3 scripts/enrich_food_business_workbook.py",
    "data:sheet:import": "python3 scripts/import_to_sheet.py",
    "data:quota:pin:both": "python3 scripts/pin_places_quota_dual_accounts.py",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "postinstall": "patch-package && node ./scripts/repair-expo-autolinking-ruby.cjs && node ./scripts/repair-expo-build-jsx.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.2.3",
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/material-top-tabs": "^7.4.23",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@rnmapbox/maps": "^10.3.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/supabase-js": "^2.103.1",
    "expo": "~55.0.23",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-dev-client": "~55.0.32",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.9",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.21",
    "expo-video": "~55.0.16",
    "expo-web-browser": "~55.0.15",
    "lucide-react-native": "^1.8.0",
    "mapbox-gl": "^2.15.0",
    "posthog-react-native": "^4.42.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@typescript/native-preview": "^7.0.0-dev.20260416.2",
    "babel-preset-expo": "~55.0.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "ws": "8.20.0",
    "postcss": "8.5.10",
    "@xmldom/xmldom": "0.8.13",
    "uuid": "14.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
