    "security:gitleaks": "gitleaks protect --staged --redact",
    "security:trufflehog": "node scripts/run-trufflehog.mjs",
    "security:supabase:enable-leaked-password": "node scripts/supabase-enable-leaked-password-protection.mjs",
    "website:predeploy:local": "npm --prefix marketing/website/web-v2 run predeploy:local",
    "release:ready": "bash scripts/release_ready_checklist.sh",
    "release:ready:local": "bash scripts/release_ready_checklist.sh --local-only",
    "smoke:native": "node scripts/run-maestro-smoke.mjs ios",
    "smoke:native:ios": "node scripts/run-maestro-smoke.mjs ios",
    "smoke:native:ios:launch": "node scripts/run-maestro-smoke.mjs ios-launch",
    "smoke:native:ios:mandatory-auth": "node scripts/run-maestro-smoke.mjs ios-mandatory-auth",
    "smoke:native:ios:authenticated-fallback": "node scripts/run-maestro-smoke.mjs ios-authenticated-fallback",
    "smoke:native:ios:auth": "node scripts/run-maestro-smoke.mjs ios-auth",
    "smoke:native:ios:location-denied": "node scripts/run-maestro-smoke.mjs ios-location-denied",
    "smoke:native:ios:review-post": "node scripts/run-maestro-smoke.mjs ios-review-post",
    "smoke:native:ios:prepared": "node scripts/prepare-maestro-smoke.mjs ios",
    "smoke:native:ios:chat": "node scripts/run-maestro-smoke.mjs ios-chat",
    "smoke:native:ios:chat:prepared": "node scripts/prepare-maestro-smoke.mjs ios-chat",
    "smoke:native:ios:media": "node scripts/run-maestro-smoke.mjs ios-media",
    "smoke:native:ios:media:prepared": "node scripts/prepare-maestro-smoke.mjs ios-media",
    "smoke:native:ios:interactions": "node scripts/run-maestro-smoke.mjs ios-interactions",
    "smoke:native:ios:interactions:prepared": "node scripts/prepare-maestro-smoke.mjs ios-interactions",
    "smoke:native:android": "node scripts/run-maestro-smoke.mjs android",
    "smoke:native:android:launch": "node scripts/run-maestro-smoke.mjs android-launch",
    "smoke:native:android:mandatory-auth": "node scripts/run-maestro-smoke.mjs android-mandatory-auth",
    "smoke:native:android:media": "node scripts/run-maestro-smoke.mjs android-media",
    "smoke:native:all": "node scripts/run-maestro-smoke.mjs all",
    "seed:generate": "tsx scripts/seed/generateSeedSQL.ts",
