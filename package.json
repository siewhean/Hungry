{
  "name": "hungry-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:channel:preview": "npx eas-cli channel:create preview --non-interactive || true",
    "eas:channel:production": "npx eas-cli channel:create production --non-interactive || true",
    "update:preview": "npx eas-cli update --channel preview --message \"${npm_config_msg:-preview update}\"",
    "update:production": "npx eas-cli update --channel production --message \"${npm_config_msg:-production update}\"",
    "typecheck": "tsgo --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "seed:generate": "tsx scripts/seed/generateSeedSQL.ts",
    "data:enrich": "python3 scripts/enrich_food_business_workbook.py",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "3.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/material-top-tabs": "^7.4.23",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@rnmapbox/maps": "^10.3.0",
    "@sentry/react-native": "~8.8.0",
    "@shopify/flash-list": "2.3.1",
    "@shopify/react-native-skia": "^2.6.2",
    "@supabase/supabase-js": "^2.103.1",
    "expo": "~55.0.15",
    "expo-asset": "^55.0.15",
    "expo-audio": "~55.0.13",
    "expo-dev-client": "~55.0.27",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.20",
    "expo-video": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "lucide-react-native": "^1.8.0",
    "posthog-react-native": "^4.42.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.72.1",
    "react-native": "0.85.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-pager-view": "8.0.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@typescript/native-preview": "^7.0.0-dev.20260416.2",
    "babel-preset-expo": "~55.0.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
