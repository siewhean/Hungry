    "data:supabase:stage:canonical:split": "python3 scripts/stage_canonical_food_businesses.py --split-output-dir",
    "data:supabase:stage:canonical:apply": "python3 scripts/stage_canonical_food_businesses.py --apply-supabase",
    "data:supabase:stage:canonical:apply-sql-chunks": "node scripts/supabase-apply-canonical-food-business-staging-chunks.mjs",
    "data:excel:validate": "python3 scripts/validate_excel_workbook.py",
    "data:excel:audit": "python3 scripts/audit_excel_source_quality.py",
    "data:excel:display-gate": "python3 scripts/audit_excel_source_quality.py --fail-unapproved-display",
    "data:excel:reconcile": "python3 scripts/reconcile_excel_workbook.py",
    "data:excel:export-app": "python3 scripts/export_excel_catalog_for_app.py",
    "data:excel:sync": "python3 scripts/sync_supabase_excel_master.py",
    "data:excel:sync:incremental": "python3 scripts/sync_supabase_excel_master.py --incremental",
    "data:excel:test": "python3 scripts/__tests__/validate_excel.test.py && python3 scripts/__tests__/audit_excel_source_quality.test.py",
    "data:excel:import": "python3 scripts/import_excel_to_supabase.py",
    "data:enrich": "python3 scripts/enrich_food_business_workbook.py",
    "data:enrich:review": "node scripts/run-scheduled-enrichment-review.mjs",
    "data:enrich:discover-grab": "node scripts/discover-grab-menu-sources.mjs",
    "data:enrich:classify-non-consumer": "python3 scripts/classify_non_consumer_entities.py",
    "data:enrich:test": "node --test scripts/auto-enrich-images.contract.test.mjs scripts/discover-grab-menu-sources.test.mjs scripts/lib/enrichment-platforms.test.mjs scripts/lib/venue-identity.test.mjs scripts/__tests__/scheduled_enrichment_review.test.mjs && python3 -m unittest scripts/test_sync_supabase_excel_master.py && python3 scripts/__tests__/classify_non_consumer_entities.test.py && python3 scripts/__tests__/dish_taxonomy.test.py && python3 scripts/__tests__/validate_excel.test.py",
    "data:sheet:import": "python3 scripts/import_to_sheet.py",
    "data:quota:pin:both": "python3 scripts/pin_places_quota_dual_accounts.py",
    "lint": "node scripts/run-eslint.cjs src/ --ext .ts,.tsx",
    "lint:fix": "node scripts/run-eslint.cjs src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "postinstall": "patch-package && node ./scripts/repair-expo-autolinking-ruby.cjs"
  },
