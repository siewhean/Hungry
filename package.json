{
  "name": "hungry-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ./scripts/run-expo.cjs start",
    "android": "node ./scripts/run-expo.cjs run:android",
    "ios": "node ./scripts/run-expo.cjs run:ios --no-build-cache",
    "web": "node ./scripts/run-expo.cjs start --web",
    "eas:channel:internal-alpha": "npx --yes eas-cli@21.1.0 channel:create internal-alpha --non-interactive || true",
    "eas:channel:preview": "npx --yes eas-cli@21.1.0 channel:create preview --non-interactive || true",
    "eas:channel:production": "npx --yes eas-cli@21.1.0 channel:create production --non-interactive || true",
    "eas-build-pre-install": "node ./scripts/configure-eas-native-profile.mjs",
    "update:internal-alpha": "node ./scripts/publish-eas-update.mjs internal-alpha",
    "update:preview": "node ./scripts/publish-eas-update.mjs preview",
    "update:production": "node ./scripts/publish-eas-update.mjs production",
    "typecheck": "node --stack_size=10000 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "HUNGRY_DATA_SOURCE=mock HUNGRY_DISABLE_ASYNC_STORAGE=1 HUNGRY_DISABLE_SECURE_STORE=1 TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test $(find src -name '*.test.ts' -print)",
    "test:render": "node scripts/test-render.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:coverage:update": "node scripts/test-coverage.mjs --update",
    "test:e2e": "playwright test",
    "test:e2e:merchant-catalog": "playwright test tests/e2e/merchant-catalog.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "smoke:supabase-chat": "node scripts/supabase-chat-smoke.mjs",
    "smoke:supabase-social-gamification": "node scripts/supabase-social-gamification-smoke.mjs",
    "smoke:supabase-full-audit-v1": "node scripts/supabase-full-audit-v1-smoke.mjs",
    "smoke:supabase-canonical-food-business-staging": "node scripts/supabase-canonical-food-business-staging-smoke.mjs",
    "smoke:database:location": "node scripts/smoke_location_queries.mjs",
    "smoke:database:search": "node scripts/smoke_search_queries.mjs",
    "smoke:database:provenance": "npx supabase db query --db-url \"${SUPABASE_DB_URL:?SUPABASE_DB_URL is required (target Supabase Postgres URL)}\" -f supabase/smoke/catalog_display_provenance.sql",
    "smoke:database:catalog-raw": "npx supabase db query --db-url \"${SUPABASE_DB_URL:?SUPABASE_DB_URL is required (target Supabase Postgres URL)}\" -f supabase/smoke/catalog_raw_reads.sql",
    "smoke:database:rls": "node scripts/smoke_rls.mjs",
    "smoke:ocr-staging": "node scripts/supabase-ocr-smoke.mjs",
    "audit:supabase:static": "node scripts/supabase-neutral-audit.mjs",
    "audit:races": "node scripts/check-race-patterns.mjs",
    "test:races": "bash supabase/race-harness/run.sh",
    "check:n-plus-one": "node scripts/check-n-plus-one.mjs",
    "test:n-plus-one": "node --test scripts/__tests__/check_n_plus_one.test.mjs",
    "audit:supabase:migration-safety": "node scripts/check-migration-safety.mjs",
    "test:migration-safety": "node --test scripts/__tests__/check_migration_safety.test.mjs",
    "audit:supabase:advisor-security": "node scripts/supabase-advisor-security-classifier.mjs",
    "audit:supabase:advisor-security:non-password": "node scripts/supabase-advisor-security-classifier.mjs --fail-on-external --ignore-leaked-password",
    "audit:supabase:advisor-support-snapshot": "node scripts/supabase-advisor-support-snapshot.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "check:edge-functions": "node scripts/check-edge-functions.mjs",
    "check:rate-limits": "node --test scripts/check-rate-limits.test.mjs && node scripts/check-rate-limits.mjs",
    "scaling:validate": "node scripts/validate-scaling-readiness.mjs",
    "load:public-web": "k6 run scripts/load/public-web.k6.js",
    "load:search": "k6 run scripts/load/search.k6.js",
    "load:discovery": "k6 run scripts/load/discovery.k6.js",
    "load:detail": "k6 run scripts/load/detail.k6.js",
    "load:post-publish": "k6 run scripts/load/post-publish.k6.js",
    "load:merchant": "k6 run scripts/load/merchant-portal.k6.js",
    "load:admin": "k6 run scripts/load/admin-dashboard.k6.js",
