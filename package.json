{
  "name": "hungry-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:channel:preview": "npx eas-cli channel:create preview --non-interactive || true",
    "eas:channel:production": "npx eas-cli channel:create production --non-interactive || true",
    "update:preview": "npx eas-cli update --channel preview --message \"${npm_config_msg:-preview update}\"",
    "update:production": "npx eas-cli update --channel production --message \"${npm_config_msg:-production update}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "data:enrich": "python3 scripts/enrich_food_business_workbook.py",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@rnmapbox/maps": "^10.3.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.103.1",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
