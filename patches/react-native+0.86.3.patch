+/*
+ * A finger landing on a row that is still sliding sideways normally only catches the slide:
+ * UIKit keeps that touch for itself, so a button under the finger never gets the tap. For rows
+ * that scroll sideways only, stop the slide here, before the touch is handed out, and report the
+ * end of the slide, so the touch reaches the button like any other tap.
+ */
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event
+{
+  if (event != nil && event.type == UIEventTypeTouches && _scrollView.isDecelerating && !_scrollView.isTracking &&
+      _scrollView.contentSize.width > _scrollView.bounds.size.width &&
+      _scrollView.contentSize.height <= _scrollView.bounds.size.height + 1.0) {
+    [_scrollView setContentOffset:_scrollView.contentOffset animated:NO];
+    [self scrollViewDidEndDecelerating:_scrollView];
+  }
+  return [super hitTest:point withEvent:event];
+}
