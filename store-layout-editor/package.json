{
  "name": "store-layout-editor",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.22.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "audit:moderate": "npm audit --audit-level=moderate",
    "check": "npm run audit:moderate && npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle:check"
  },
  "dependencies": {
    "perspective-transform": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
