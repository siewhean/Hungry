ory"\n                : shouldShowUnseenRing\n                  ? "Opens this unseen story"\n                  : "Replays this story"\n            }\n            accessibilityState={{ selected: Boolean(shouldShowUnseenRing) }}\n          >\n            <View style={styles.ringOuter}>\n              {/* Ring: orange gradient = unseen (any story type), grey = already seen */}\n              {shouldShowUnseenRing ? (\n                <LinearGradient\n                  colors={[palette.orange, palette.amber]}\n                  start={{ x: 0, y: 0 }}\n                  end={{ x: 1, y: 1 }}\n                  style={[styles.gradientRing, { borderRadius: radii.pill }]}\n                >\n                  <View\n                    style={[\n                      styles.avatarInner,\n                      { backgroundColor: palette.bg, borderRadius: radii.pill },\n                    ]}\n                  >\n                    <AccessibleImage\n                      source={{ uri: story.avatarUrl }}\n                      decorative\n                      style={[styles.avatar, { borderRadius: radii.pill }]}\n                    />\n                  </View>\n                </LinearGradient>\n              ) : (\n                <View\n                  style={[\n                    styles.solidRing,\n                    {\n                      borderColor: palette.textMuted,\n                      borderRadius: radii.pill,\n                    },\n                  ]}\n                >\n                  <View\n                    style={[\n                      styles.avatarInner,\n                      { backgroundColor: palette.bg, borderRadius: radii.pill },\n                    ]}\n                  >\n                    <AccessibleImage\n                      source={{ uri: story.avatarUrl }}\n                      decorative\n                      style={[styles.avatar, { borderRadius: radii.pill }]}\n                    />\n                  </View>\n                </View>\n              )}\n\n              {/* "Your story" + add icon */}\n              {story.isOwn && (\n                <View\n                  accessibilityElementsHidden\n                  importantForAccessibility="no"\n                  pointerEvents="none"\n                  style={[\n                    styles.addBadge,\n                    { backgroundColor: palette.orange, borderColor: palette.bg },\n                  ]}\n                >\n                  <Plus color={palette.white} size={12} strokeWidth={3} />\n                </View>\n              )}\n\n              {/* Stall fork badge */}\n              {story.isStall && !story.isOwn && (\n                <View\n                  accessibilityElementsHidden\n                  importantForAccessibility="no"\n                  style={[\n                    styles.forkBadge,\n                    { backgroundColor: palette.orange, borderColor: palette.bg },\n                  ]}\n                >\n                  <Utensils color={palette.white} size={9} strokeWidth={2.5} />\n                </View>\n              )}\n            </View>\n\n            <AppText\n              variant="micro"\n              numberOfLines={1}\n              style={[styles.label, { color: story.isOwn ? palette.textMuted : palette.text }]}\n            >\n              {story.displayName}\n            </AppText>\n          </Pressable>\n        );\n      })}\n    </ScrollView>\n  );\n});\n\nconst styles = StyleSheet.create({\n  item: {\n    alignItems: "center",\n    gap: 6,\n    width: 72,\n  },\n  ringOuter: {\n    position: "relative",\n  },\n  gradientRing: {\n    padding: 3,\n  },\n  solidRing: {\n    borderWidth: 2.5,\n    padding: 2,\n  },\n  avatarInner: {\n    padding: 2,\n  },\n  avatar: {\n    width: 56,\n    height: 56,\n  },\n  addBadge: {\n    position: "absolute",\n    bottom: 0,\n    right: 0,\n    width: 20,\n    height: 20,\n    borderRadius: 10,\n    borderWidth: 2,\n    alignItems: "center",\n    justifyContent: "center",\n  },\n  forkBadge: {\n    position: "absolute",\n    bottom: -1,\n    right: -1,\n    width: 18,\n    height: 18,\n    borderRadius: 9,\n    borderWidth: 2,\n    alignItems: "center",\n    justifyContent: "center",\n  },\n  label: {\n    textAlign: "center",\n    width: "100%",\n  },\n});\n',
